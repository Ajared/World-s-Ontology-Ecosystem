@prefix ex: <https://example.org/worlds-ontology-ecosystem/day1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/worlds-ontology-ecosystem/day1>
    a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ;
    rdfs:label "Day 1 Patrol Boat Exercise (completed)"@en ;
    rdfs:comment "Completed Day 1 exercise: class hierarchy placed under BFO, individuals and assertions added, and MovingPatrolBoat defined with necessary and sufficient conditions."@en .

#################################################################
# Local classes
#################################################################

ex:PatrolBoat
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000040 ;
    rdfs:label "PatrolBoat"@en .

ex:ActOfMotion
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "ActOfMotion"@en .

ex:MeasurementDatum
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "MeasurementDatum"@en .

ex:SpeedMeasurementDatum
    a owl:Class ;
    rdfs:subClassOf ex:MeasurementDatum ;
    rdfs:label "SpeedMeasurementDatum"@en .

ex:DurationMeasurementDatum
    a owl:Class ;
    rdfs:subClassOf ex:MeasurementDatum ;
    rdfs:label "DurationMeasurementDatum"@en .

ex:MeasurementUnit
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "MeasurementUnit"@en ;
    rdfs:comment "A simplified informational representation of a measurement unit for this exercise."@en .

ex:MovingPatrolBoat
    a owl:Class ;
    rdfs:label "MovingPatrolBoat"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            ex:PatrolBoat
            [ a owl:Restriction ;
              owl:onProperty obo:BFO_0000056 ;
              owl:someValuesFrom ex:ActOfMotion ]
        )
    ] .

#################################################################
# Local properties
#################################################################

ex:isAbout
    a owl:ObjectProperty ;
    rdfs:label "is about"@en .

ex:hasMeasurementUnit
    a owl:ObjectProperty ;
    rdfs:label "has measurement unit"@en .

ex:hasDecimalValue
    a owl:DatatypeProperty ;
    rdfs:label "has decimal value"@en ;
    rdfs:range xsd:decimal .

#################################################################
# Individuals
#################################################################

ex:patrol_boat_01
    a owl:NamedIndividual , ex:PatrolBoat ;
    rdfs:label "patrol_boat_01"@en ;
    obo:BFO_0000056 ex:motion_01 .

ex:motion_01
    a owl:NamedIndividual , ex:ActOfMotion ;
    rdfs:label "motion_01"@en .

ex:speed_measurement_01
    a owl:NamedIndividual , ex:SpeedMeasurementDatum ;
    rdfs:label "speed_measurement_01"@en ;
    ex:isAbout ex:motion_01 ;
    ex:hasMeasurementUnit ex:knot ;
    ex:hasDecimalValue "12.0"^^xsd:decimal .

ex:duration_measurement_01
    a owl:NamedIndividual , ex:DurationMeasurementDatum ;
    rdfs:label "duration_measurement_01"@en ;
    ex:isAbout ex:motion_01 ;
    ex:hasMeasurementUnit ex:hour ;
    ex:hasDecimalValue "1.0"^^xsd:decimal .

ex:knot
    a owl:NamedIndividual , ex:MeasurementUnit ;
    rdfs:label "knot"@en .

ex:hour
    a owl:NamedIndividual , ex:MeasurementUnit ;
    rdfs:label "hour"@en .

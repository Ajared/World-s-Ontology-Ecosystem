@prefix : <https://example.org/worlds-ontology-ecosystem/day2/case-2/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/worlds-ontology-ecosystem/day2/case-2>
    a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ;
    rdfs:label "Day 2 Case 2: designed vs. measured approach speed (Airbus A321-111)"@en ;
    rdfs:comment "Source: aircraft_data.xlsx, row 13 (ICAO A321, BADA model 'Airbus A321-111', Approach_Speed_maximum_knot = 142). The test scenario (five approaches, average 139 kt) comes from the case statement."@en .

#################################################################
# Classes
#################################################################

:FixedWingAircraft
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "fixed-wing aircraft"@en ;
    skos:definition "An object that is designed to fly by means of lift generated by wings that are fixed to its fuselage."@en .

:AircraftDesignSpecification
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "aircraft design specification"@en ;
    skos:definition "A generically dependent continuant that prescribes the characteristics that aircraft built to some aircraft model are designed to have."@en .

:MaximumApproachSpeedSpecification
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000176 ; owl:someValuesFrom :AircraftDesignSpecification ] ;
    rdfs:label "maximum approach speed specification"@en ;
    skos:definition "A generically dependent continuant that is part of an aircraft design specification and that prescribes the greatest speed at which aircraft built to that design are to fly during a final approach."@en .

:ApproachProcess
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom :FixedWingAircraft ] ;
    rdfs:label "approach process"@en ;
    skos:definition "A process in which an aircraft descends along a flight path toward a runway in preparation for landing."@en .

:ApproachTestProcess
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom :ApproachProcess ] ;
    rdfs:label "approach test process"@en ;
    skos:definition "A process that has approach processes as occurrent parts and whose purpose is to obtain measurements of how an aircraft performs during those approaches."@en .

:ApproachSpeedMeasurementDatum
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ,
        [ a owl:Restriction ; owl:onProperty obo:DEMO_0000001 ; owl:someValuesFrom :ApproachProcess ] ;
    rdfs:label "approach speed measurement datum"@en ;
    skos:definition "A generically dependent continuant that is about an approach process and that records the maximum speed reached by the aircraft during that approach."@en .

:AverageApproachSpeedDatum
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ,
        [ a owl:Restriction ; owl:onProperty obo:DEMO_0000001 ; owl:someValuesFrom :ApproachTestProcess ] ,
        [ a owl:Restriction ; owl:onProperty :isDerivedFrom ; owl:someValuesFrom :ApproachSpeedMeasurementDatum ] ;
    rdfs:label "average approach speed datum"@en ;
    skos:definition "A generically dependent continuant that is about an approach test process and whose value is the arithmetic mean of the approach speed measurement data obtained in that test."@en .

:WithinDesignLimitAverageApproachSpeedDatum
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :AverageApproachSpeedDatum
            [ a owl:Restriction ;
              owl:onProperty :hasDecimalValue ;
              owl:someValuesFrom [
                  a rdfs:Datatype ;
                  owl:onDatatype xsd:decimal ;
                  owl:withRestrictions ( [ xsd:maxInclusive "142"^^xsd:decimal ] )
              ] ]
        )
    ] ;
    rdfs:label "within-design-limit average approach speed datum"@en ;
    skos:definition "An average approach speed datum whose value does not exceed the 142 knot maximum approach speed prescribed by the Airbus A321-111 design specification."@en .

#################################################################
# Object properties
#################################################################

:prescribes
    a owl:ObjectProperty ;
    rdfs:domain obo:BFO_0000031 ;
    rdfs:label "prescribes"@en ;
    skos:definition "A relation that holds between a directive information entity and an entity when the entity is, or is to be, made or carried out in accordance with what the information entity directs."@en .

:isDerivedFrom
    a owl:ObjectProperty ;
    rdfs:domain obo:BFO_0000031 ;
    rdfs:range obo:BFO_0000031 ;
    rdfs:label "is derived from"@en ;
    skos:definition "A relation that holds between two information entities when the first was produced by a calculation that took the second as one of its inputs."@en .

#################################################################
# Data properties
#################################################################

:hasDecimalValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "has decimal value"@en ;
    skos:definition "A relation that holds between an information entity and a decimal number when the number is the quantitative value that the information entity records."@en .

:hasUnitLabel
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has unit label"@en ;
    skos:definition "A relation that holds between an information entity and a string when the string names the unit of measure in which the information entity's value is expressed."@en .

:hasModelDesignation
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has model designation"@en ;
    skos:definition "A relation that holds between a design specification and a string when the string is the name that a registry uses for the aircraft model the specification prescribes."@en .

#################################################################
# Individuals
#################################################################

:a321_111_design_spec
    a owl:NamedIndividual , :AircraftDesignSpecification ;
    rdfs:label "Airbus A321-111 design specification"@en ;
    skos:definition "The aircraft design specification for the Airbus A321-111, as recorded in row 13 of aircraft_data.xlsx."@en ;
    :hasModelDesignation "Airbus A321-111" ;
    :prescribes :a321_111_aircraft_1 .

:a321_111_max_approach_speed_spec
    a owl:NamedIndividual , :MaximumApproachSpeedSpecification ;
    rdfs:label "A321-111 maximum approach speed specification"@en ;
    skos:definition "The part of the A321-111 design specification that prescribes a maximum approach speed of 142 knots (column O of row 13)."@en ;
    obo:BFO_0000176 :a321_111_design_spec ;
    :hasDecimalValue "142"^^xsd:decimal ;
    :hasUnitLabel "knot" .

:a321_111_aircraft_1
    a owl:NamedIndividual , :FixedWingAircraft ;
    rdfs:label "A321-111 aircraft 1"@en ;
    skos:definition "The particular Airbus A321-111 airframe that took part in the five-approach test described in the case."@en ;
    obo:BFO_0000056 :approach_test_1 , :approach_1 , :approach_2 , :approach_3 , :approach_4 , :approach_5 .

:approach_test_1
    a owl:NamedIndividual , :ApproachTestProcess ;
    rdfs:label "approach test 1"@en ;
    skos:definition "The test process, made up of five approaches, in which A321-111 aircraft 1 was flown."@en ;
    obo:BFO_0000117 :approach_1 , :approach_2 , :approach_3 , :approach_4 , :approach_5 .

:approach_1 a owl:NamedIndividual , :ApproachProcess ;
    rdfs:label "approach 1"@en ;
    skos:definition "The first of the five approaches flown by A321-111 aircraft 1 in approach test 1."@en .
:approach_2 a owl:NamedIndividual , :ApproachProcess ;
    rdfs:label "approach 2"@en ;
    skos:definition "The second of the five approaches flown by A321-111 aircraft 1 in approach test 1."@en .
:approach_3 a owl:NamedIndividual , :ApproachProcess ;
    rdfs:label "approach 3"@en ;
    skos:definition "The third of the five approaches flown by A321-111 aircraft 1 in approach test 1."@en .
:approach_4 a owl:NamedIndividual , :ApproachProcess ;
    rdfs:label "approach 4"@en ;
    skos:definition "The fourth of the five approaches flown by A321-111 aircraft 1 in approach test 1."@en .
:approach_5 a owl:NamedIndividual , :ApproachProcess ;
    rdfs:label "approach 5"@en ;
    skos:definition "The fifth of the five approaches flown by A321-111 aircraft 1 in approach test 1."@en .

# The case gives only the average, so the individual measurement values are not asserted.
:approach_speed_msr_1 a owl:NamedIndividual , :ApproachSpeedMeasurementDatum ;
    rdfs:label "approach speed measurement 1"@en ;
    skos:definition "The maximum approach speed measurement recorded for approach 1; its value is not given in the source."@en ;
    obo:DEMO_0000001 :approach_1 ;
    :hasUnitLabel "knot" .
:approach_speed_msr_2 a owl:NamedIndividual , :ApproachSpeedMeasurementDatum ;
    rdfs:label "approach speed measurement 2"@en ;
    skos:definition "The maximum approach speed measurement recorded for approach 2; its value is not given in the source."@en ;
    obo:DEMO_0000001 :approach_2 ;
    :hasUnitLabel "knot" .
:approach_speed_msr_3 a owl:NamedIndividual , :ApproachSpeedMeasurementDatum ;
    rdfs:label "approach speed measurement 3"@en ;
    skos:definition "The maximum approach speed measurement recorded for approach 3; its value is not given in the source."@en ;
    obo:DEMO_0000001 :approach_3 ;
    :hasUnitLabel "knot" .
:approach_speed_msr_4 a owl:NamedIndividual , :ApproachSpeedMeasurementDatum ;
    rdfs:label "approach speed measurement 4"@en ;
    skos:definition "The maximum approach speed measurement recorded for approach 4; its value is not given in the source."@en ;
    obo:DEMO_0000001 :approach_4 ;
    :hasUnitLabel "knot" .
:approach_speed_msr_5 a owl:NamedIndividual , :ApproachSpeedMeasurementDatum ;
    rdfs:label "approach speed measurement 5"@en ;
    skos:definition "The maximum approach speed measurement recorded for approach 5; its value is not given in the source."@en ;
    obo:DEMO_0000001 :approach_5 ;
    :hasUnitLabel "knot" .

:average_approach_speed_1
    a owl:NamedIndividual , :AverageApproachSpeedDatum ;
    rdfs:label "average approach speed for approach test 1"@en ;
    skos:definition "The average maximum approach speed of 139 knots calculated from the five measurements taken in approach test 1."@en ;
    obo:DEMO_0000001 :approach_test_1 ;
    :isDerivedFrom :approach_speed_msr_1 , :approach_speed_msr_2 , :approach_speed_msr_3 , :approach_speed_msr_4 , :approach_speed_msr_5 ;
    :hasDecimalValue "139"^^xsd:decimal ;
    :hasUnitLabel "knot" .

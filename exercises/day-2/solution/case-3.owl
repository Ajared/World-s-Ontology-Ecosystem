@prefix : <https://example.org/worlds-ontology-ecosystem/day2/case-3/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/worlds-ontology-ecosystem/day2/case-3>
    a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ;
    rdfs:label "Day 2 Case 3: SOC entries mentioning 'Aerospace Engineer'"@en ;
    rdfs:comment "Source: soc_structure_definitions.xlsx, sheet 'SOC Definitions', rows 188 (17-2010), 189 (17-2011) and 229 (17-3021)."@en .

#################################################################
# Classes
#################################################################

:SOCEntry
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000031 ;
    rdfs:label "SOC entry"@en ;
    skos:definition "A generically dependent continuant that is part of the Standard Occupational Classification and that assigns a code and title to a group of occupations."@en .

:BroadOccupationEntry
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :SOCEntry [ a owl:Restriction ; owl:onProperty :hasSOCLevel ; owl:hasValue "Broad" ] )
    ] ;
    rdfs:label "broad occupation entry"@en ;
    skos:definition "A SOC entry at the broad-occupation level, grouping one or more detailed occupations under a code ending in zero."@en .

:DetailedOccupationEntry
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( :SOCEntry [ a owl:Restriction ; owl:onProperty :hasSOCLevel ; owl:hasValue "Detailed" ] )
    ] ;
    rdfs:label "detailed occupation entry"@en ;
    skos:definition "A SOC entry at the detailed-occupation level, which is the most specific level of the classification and carries a SOC definition."@en .

:JobRole
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;
    rdfs:label "job role"@en ;
    skos:definition "A role that a person bears in virtue of being employed to perform some kind of work."@en .

:EngineerRole
    a owl:Class ;
    rdfs:subClassOf :JobRole ;
    owl:disjointWith :TechnicianRole ;
    rdfs:label "engineer role"@en ;
    skos:definition "A job role whose realizations consist in applying engineering knowledge to design, build, or test artifacts."@en .

:TechnicianRole
    a owl:Class ;
    rdfs:subClassOf :JobRole ;
    rdfs:label "technician role"@en ;
    skos:definition "A job role whose realizations consist in operating, installing, adjusting, or maintaining technical equipment."@en .

:AerospaceEngineerRole
    a owl:Class ;
    rdfs:subClassOf :EngineerRole ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:allValuesFrom :AerospaceEngineeringProcess ] ;
    rdfs:label "aerospace engineer role"@en ;
    skos:definition "An engineer role that is realized only in processes of designing, constructing, or testing aerospace vehicles."@en .

:AerospaceEngineeringTechnicianRole
    a owl:Class ;
    rdfs:subClassOf :TechnicianRole ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:allValuesFrom :AerospaceEquipmentOperationProcess ] ;
    rdfs:label "aerospace engineering and operations technician role"@en ;
    skos:definition "A technician role that is realized only in processes of operating, installing, adjusting, or maintaining equipment used to launch, track, position, or evaluate aerospace vehicles."@en .

:AerospaceVehicle
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "aerospace vehicle"@en ;
    skos:definition "An object that is designed to travel through the atmosphere or outer space; aircraft, missiles, and spacecraft fall under it."@en .

:AerospaceEngineeringProcess
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom :AerospaceVehicle ] ;
    rdfs:label "aerospace engineering process"@en ;
    skos:definition "A process in which an aerospace vehicle is designed, constructed, or tested by applying engineering methods."@en .

:AerospaceEquipmentOperationProcess
    a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "aerospace equipment operation process"@en ;
    skos:definition "A process in which equipment used to launch, track, position, or evaluate aerospace vehicles is operated, installed, adjusted, or maintained."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( :AerospaceEngineeringProcess :AerospaceEquipmentOperationProcess ) .

#################################################################
# Data properties
#################################################################

:hasSOCCode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :SOCEntry ;
    rdfs:range xsd:string ;
    rdfs:label "has SOC code"@en ;
    skos:definition "A relation that holds between a SOC entry and a string when the string is the code that the classification assigns to that entry."@en .

:hasSOCTitle
    a owl:DatatypeProperty ;
    rdfs:domain :SOCEntry ;
    rdfs:range xsd:string ;
    rdfs:label "has SOC title"@en ;
    skos:definition "A relation that holds between a SOC entry and a string when the string is the title the classification gives that entry."@en .

:hasSOCLevel
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :SOCEntry ;
    rdfs:range xsd:string ;
    rdfs:label "has SOC level"@en ;
    skos:definition "A relation that holds between a SOC entry and a string when the string names the level of the classification hierarchy (Major, Minor, Broad, Detailed) at which the entry sits."@en .

:hasSOCDefinitionText
    a owl:DatatypeProperty ;
    rdfs:domain :SOCEntry ;
    rdfs:range xsd:string ;
    rdfs:label "has SOC definition text"@en ;
    skos:definition "A relation that holds between a SOC entry and a string when the string is the definition that the classification publishes for that entry."@en .

#################################################################
# Individuals
#################################################################

:soc_17_2010
    a owl:NamedIndividual , :SOCEntry ,
        [ a owl:Restriction ; owl:onProperty obo:DEMO_0000001 ; owl:allValuesFrom
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom :AerospaceEngineerRole ] ] ;
    rdfs:label "SOC 17-2010 Aerospace Engineers (broad)"@en ;
    skos:definition "The broad occupation entry 17-2010 'Aerospace Engineers' (row 188); it groups exactly one detailed occupation, 17-2011, and has no definition of its own."@en ;
    :hasSOCCode "17-2010" ;
    :hasSOCTitle "Aerospace Engineers" ;
    :hasSOCLevel "Broad" .

:soc_17_2011
    a owl:NamedIndividual , :SOCEntry ,
        [ a owl:Restriction ; owl:onProperty obo:DEMO_0000001 ; owl:allValuesFrom
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom :AerospaceEngineerRole ] ] ;
    rdfs:label "SOC 17-2011 Aerospace Engineers (detailed)"@en ;
    skos:definition "The detailed occupation entry 17-2011 'Aerospace Engineers' (row 189), which is the only detailed occupation within broad group 17-2010."@en ;
    obo:BFO_0000176 :soc_17_2010 ;
    :hasSOCCode "17-2011" ;
    :hasSOCTitle "Aerospace Engineers" ;
    :hasSOCLevel "Detailed" ;
    :hasSOCDefinitionText "Perform engineering duties in designing, constructing, and testing aircraft, missiles, and spacecraft. May conduct basic and applied research to evaluate adaptability of materials and equipment to aircraft design and manufacture. May recommend improvements in testing equipment and techniques." .

:soc_17_3021
    a owl:NamedIndividual , :SOCEntry ,
        [ a owl:Restriction ; owl:onProperty obo:DEMO_0000001 ; owl:allValuesFrom
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom :AerospaceEngineeringTechnicianRole ] ] ;
    rdfs:label "SOC 17-3021 Aerospace Engineering and Operations Technologists and Technicians"@en ;
    skos:definition "The detailed occupation entry 17-3021 (row 229); its title mentions aerospace engineering, but it classifies technician work, not engineer work."@en ;
    :hasSOCCode "17-3021" ;
    :hasSOCTitle "Aerospace Engineering and Operations Technologists and Technicians" ;
    :hasSOCLevel "Detailed" ;
    :hasSOCDefinitionText "Operate, install, adjust, and maintain integrated computer/communications systems, consoles, simulators, and other data acquisition, test, and measurement instruments and equipment, which are used to launch, track, position, and evaluate air and space vehicles. May record and interpret test data." .
